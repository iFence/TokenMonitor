// TokenMonitor Windows resources.
//
// Resource ID 1 (RT_ICON) is the application icon. GPUI's Windows platform
// loads exactly this ID via LoadImageW(hModule, MAKEINTRESOURCE(1),
// IMAGE_ICON, ...) and registers it on the window class, so the window and
// taskbar pick it up automatically.

1 ICON "tokenmonitor.ico"

1 VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "TokenMonitor"
      VALUE "FileDescription", "TokenMonitor - AI coding tool token usage tracker"
      VALUE "FileVersion", "0.2.0"
      VALUE "ProductName", "TokenMonitor"
      VALUE "ProductVersion", "0.2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
